node-linker=isolated

# Explicit default (base) registry = npmjs. Dependabot runs pnpm 11.8+, which —
# unlike npm — does NOT fall back across registries. When the account publishes
# to GitHub Packages, Dependabot otherwise treats npm.pkg.github.com as the base
# for ALL packages, so public deps (prettier, etc.) resolve there, 404, and are
# silently never updated (dependabot-core#15415). Pinning npmjs as the base keeps
# public resolution correct while @rmartz stays scoped to GitHub Packages below.
registry=https://registry.npmjs.org/

# @rmartz/* packages (e.g. @rmartz/repo-hygiene) publish to GitHub Packages.
# `pnpm install` must authenticate: set NODE_AUTH_TOKEN in the environment
# (locally: `NODE_AUTH_TOKEN=$(gh auth token) pnpm install`; in CI it is the
# job's GITHUB_TOKEN with `packages: read`). See CONTRIBUTING.md.
@rmartz:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
