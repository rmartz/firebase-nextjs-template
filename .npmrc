node-linker=isolated

# Explicit default (base) registry = npmjs. Dependabot runs pnpm 11.8+, which —
# unlike npm — does NOT fall back across registries, so an ambient GitHub Packages
# base would make public deps (prettier, etc.) resolve there, 404, and silently
# never update (dependabot-core#15415). Pinning npmjs as the base keeps public
# resolution correct.
registry=https://registry.npmjs.org/

# @rmartz/* packages this repo installs (e.g. @rmartz/repo-hygiene) are public on
# npmjs and need no auth. Pin the scope explicitly anyway: a user-level .npmrc that
# maps @rmartz to GitHub Packages (still used by other @rmartz packages) would
# otherwise redirect installs there, where new versions are no longer published.
@rmartz:registry=https://registry.npmjs.org/
