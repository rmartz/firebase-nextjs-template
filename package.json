{
  "name": "firebase-nextjs-template",
  "version": "0.1.0",
  "description": "Template repository for Next.js projects built on Firebase",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "tsc": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "prepare": "husky",
    "emulator": "firebase emulators:start",
    "actions:validate": "node scripts/validate-action-pins.mjs",
    "docs:validate": "node scripts/validate-docs.mjs",
    "fragility:report": "node scripts/validate-anchor-uniqueness.mjs",
    "env:validate": "node scripts/validate-config.mjs",
    "pins:validate": "node scripts/validate-pins.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/nextjs": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-redux": "^9.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.19.1",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
