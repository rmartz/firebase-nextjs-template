{
  "name": "firebase-nextjs-template",
  "version": "0.1.0",
  "description": "Template repository for Next.js projects built on Firebase",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "tsc": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "emulator": "firebase emulators:start",
    "hygiene": "ai-repo-hygiene conflict-markers action-pins package-pins md-pairing okf okf-index file-caps --check --config .repo-hygiene.yml",
    "hygiene:staged": "ai-repo-hygiene conflict-markers action-pins package-pins md-pairing okf okf-index file-caps --staged --config .repo-hygiene.yml",
    "fragility:report": "node scripts/validate-anchor-uniqueness.mjs",
    "fragility:mine": "node scripts/mine-edit-outcomes.mjs",
    "fragility:eval": "node scripts/eval-edit-fragility.mjs",
    "fragility:snapshot": "node scripts/eval-edit-fragility.mjs --snapshot metrics/edit-fragility-history.jsonl",
    "env:validate": "node scripts/validate-config.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "@sentry/nextjs": "10.73.0",
    "@tanstack/react-query": "5.102.8",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.19.0",
    "firebase-admin": "14.4.0",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rmartz/repo-hygiene": "7.0.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "5.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.3",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "yaml": "2.9.1"
  }
}
