# Skip in git worktrees — .git is a file there (not a directory).
# Agent commits in worktrees are covered by claude/hooks/pre-commit instead.
if [ -f ".git" ]; then
  exit 0
fi
# Repo-hygiene gates over staged content (conflict markers, action pins,
# AGENTS/CLAUDE pairing, OKF frontmatter, file caps) — @rmartz/repo-hygiene.
pnpm run hygiene:staged
# lint-staged runs eslint on staged files, which enforces the JS/TS file-length
# hard cap via the `max-lines` rule (file-caps covers the other file types).
pnpm exec lint-staged
pnpm run env:validate
